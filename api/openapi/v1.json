  "components": {
    "schemas": {
      "AiHealth": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "AnswerStatus": {
        "enum": [
          "answered",
          "not_found",
          "uncited",
          "clarify"
        ]
      },
      "AskIn": {
        "required": [
          "question"
        ],
        "type": "object",
        "properties": {
          "question": {
            "maxLength": 1000,
            "minLength": 3,
            "type": "string"
          },
          "k": {
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "mode": {
            "pattern": "^(pipeline|agent)\\z",
            "type": "string"
          },
          "conversationId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "answersClarification": {
            "type": "boolean"
          }
        }
      },
      "AskResponse": {
        "required": [
          "conversationId",
          "messageId",
          "status",
          "answer",
          "sources",
          "action",
          "trace"
        ],
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "messageId": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/AnswerStatus"
          },
          "answer": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceOut"
            }
          },
          "action": {
            "type": "string"
          },
          "trace": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ConversationOut": {
        "required": [
          "id",
          "title",
          "createdAt",
          "updatedAt",
          "messages"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageOut"
            }
          }
        }
      },
      "ConversationSummary": {
        "required": [
          "id",
          "title",
          "messages",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "messages": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DocumentIn": {
        "required": [
          "name",
          "content"
        ],
        "type": "object",
        "properties": {
          "name": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,98}\\.md\\z",
            "type": "string"
          },
          "content": {
            "maxLength": 200000,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "DocumentInfo": {
        "required": [
          "name",
          "chars",
          "chunks",
          "status",
          "error",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "chars": {
            "type": "integer",
            "format": "int32"
          },
          "chunks": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DocumentStatus": {
        "enum": [
          "Pending",
          "Indexed",
          "Failed"
        ]
      },
      "HealthOut": {
        "required": [
          "status",
          "ai"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "ai": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AiHealth"
              }
            ]
          }
        }
      },
