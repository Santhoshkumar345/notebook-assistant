<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Pinned above the version Microsoft.AspNetCore.OpenApi brings in transitively (2.0.0), which has a known high-severity
         advisory (GHSA-v5pm-xwqc-g5wc, circular schema references in OpenAPI parsing). 2.7.5 is the patched release of the 2.x line.
         Remove this pin once Microsoft.AspNetCore.OpenApi depends on a patched version itself. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

</Project>
