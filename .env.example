# Copy to ai-service/.env and fill in. .env is gitignored - never commit real keys, and never put real values in this file.
GEMINI_API_KEY=

# The secret the .NET API presents to this service. The service refuses to start without it (16+ characters).
# Make one with:  python -c "import secrets; print(secrets.token_hex(24))"
# The API needs the same value: dotnet user-secrets set "AiService:ApiKey" "<the same value>"  (see the README).
AI_SERVICE_KEY=
